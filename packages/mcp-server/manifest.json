{
  "dxt_version": "0.1",
  "name": "gizmo-mcp",
  "version": "0.0.1",
  "description": "The official MCP Server for the Gizmo API",
  "author": {
    "name": "Gizmo",
    "email": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainless-sdks/gizmo-typescript.git"
  },
  "homepage": "https://github.com/stainless-sdks/gizmo-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "",
  "server": {
    "type": "node",
    "entry_point": "${__dirname}/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "GIZMO_API_KEY": "${user_config.GIZMO_API_KEY}"
      }
    }
  },
  "user_config": {
    "GIZMO_API_KEY": {
      "title": "api_key",
      "description": "The API key (generated from App Dashboard)",
      "required": false,
      "type": "string"
    }
  },
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
